  RootNode:
    dialogueText: 'Hello officer what can i do for you '
    responses:
    - responseText: 'have you seen a child around here recently '
      nextNode:
        dialogueText: 'yes actually i have i reember seeing him playing with a ball
          but his dad came to get him or so i geuss '
        responses:
        - responseText: 'do you know where they went off to '
          nextNode:
            dialogueText: 'no i don''t recall where they went '
            responses:
            - responseText: 'alright then have a good evening '
              nextNode:
                dialogueText: 
                responses: []
    - responseText: 'your under arrest '
      nextNode:
        dialogueText: 'for what '
        responses:
        - responseText: 'nerver mind that  i could let you off the hook if you tell
            me where the kid went '
          nextNode:
            dialogueText: 'You mean the kid with the red ball '
            responses:
            - responseText: 'yes! '
              nextNode:
                dialogueText: 'he went to the left pathway i don''t know anything
                  more '
                responses:
                - responseText: good
                  nextNode:
                    dialogueText: 
                    responses: []
            - responseText: 'no! '
              nextNode:
                dialogueText: 'then what kid? '
                responses:
                - responseText: Of course the kid with the red ball!
                  nextNode:
                    dialogueText: 'he went to the left pathway i don''t know anything
                      more '
                    responses:
                    - responseText: 'great answer '
