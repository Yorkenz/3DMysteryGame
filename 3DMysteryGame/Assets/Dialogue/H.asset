  RootNode:
    dialogueText: yes
    responses:
    - responseText: Hello, How are you doing tonight?
      nextNode:
        dialogueText: good thank you
        responses:
        - responseText: Hey, have you seen the recent kid that went missing somewhere
            around here?
          nextNode:
            dialogueText: " No not at all, I just got here actually, but I\u2019ll
