  RootNode:
    dialogueText: 'good evening sunny '
    responses:
    - responseText: 'good evening ma''am have you seen a young boy around here recently '
      nextNode:
        dialogueText: 'you know i dont have that great of a memory like a used to
          but i can give you a secret recipe that not even my grandkids know about '
        responses:
        - responseText: 'sure what is it '
          nextNode:
            dialogueText: 'nope if my grandkids don''t even know why would i tell
              you '
            responses:
            - responseText: 'okay then have a good night '
              nextNode:
                dialogueText: 
                responses: []
        - responseText: i'm afraid not i have to look for the boy
          nextNode:
            dialogueText: 'alright sunny don''t stay in the rain too long  '
            responses:
            - responseText: 'thank you ma''am have a good night '
              nextNode:
                dialogueText: 
                responses: []
